# PrimePrep Frontend Environment Variables

# In development on unified dev server / preview container (Recommended):
VITE_API_BASE_URL=/api

# In standalone development with separate backend server on port 5000:
# VITE_API_BASE_URL=http://localhost:5000/api

# In production deployment on Vercel pointing to Render:
# VITE_API_BASE_URL=https://primeprep-api.onrender.com/api
