# ==============================================================================
# PrimePrep: Environment Configuration Example
# Stack: PERN (PostgreSQL via pg, Express.js, React.js, Node.js)
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL via pg connection pool)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Frontend Origin (Used for CORS whitelist)
FRONTEND_URL=http://localhost:3000

# API Base URL for Vite Client
# Use '/api' for same-origin dev server and reverse proxy deployments
# For decoupled deployments (e.g., Vercel frontend + Render backend), set:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
VITE_API_BASE_URL=/api

# ==============================================================================
# SECURITY SECRETS (STRICT SEPARATION REQUIRED)
# ==============================================================================
# 1. JWT_SECRET:
#    Used exclusively for cryptographically signing and verifying user session JWTs.
#    Must be a random high-entropy secret, minimum 32 characters.
#    NEVER use this as ADMIN_SETUP_SECRET.
JWT_SECRET=generate_a_random_high_entropy_secret_min_32_characters

# 2. ADMIN_SETUP_SECRET:
#    Used strictly for the one-time initial administrator bootstrap endpoint (POST /api/auth/setup-admin).
#    Must be completely independent from JWT_SECRET and at least 32 characters.
#    Once an administrator account is created in PostgreSQL, initial bootstrap is permanently locked.
ADMIN_SETUP_SECRET=generate_a_distinct_separate_random_secret_min_32_chars
