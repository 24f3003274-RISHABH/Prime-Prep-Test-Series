# PrimePrep Backend Environment Variables
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection String (Session / Transaction Pooler or Direct)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Secret keys (must be set to high-entropy strings in production)
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ADMIN_SETUP_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET
