# ==============================================================================
# PrimePrep Backend Environment Configuration Example
# ==============================================================================

PORT=3000
NODE_ENV=development

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Allowed Origin for CORS
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# SECURITY SECRETS (STRICT SEPARATION REQUIRED)
# ==============================================================================
# 1. JWT_SECRET: Minimum 32 characters, used only for signing JWT session tokens.
JWT_SECRET=generate_a_random_high_entropy_secret_min_32_characters

# 2. ADMIN_SETUP_SECRET: Minimum 32 characters, used strictly for initial administrator bootstrap.
#    Must NOT share the same value as JWT_SECRET.
ADMIN_SETUP_SECRET=generate_a_distinct_separate_random_secret_min_32_chars
